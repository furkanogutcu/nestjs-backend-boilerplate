# app
PORT=                                       # Required
APP_URL=                                    # Required. Public base URL of the web front-end; emailed verification & password-reset links point here.
NODE_ENV=production                         # Optional. Enum: [production, development, test]. Default: production
LOG_LEVEL=                                  # Optional. Enum: [fatal,error,warn,info,debug,trace,silent]. Default: dev=debug, prod=info
TRUST_PROXY=loopback                        # Optional. Express 'trust proxy'. Default: loopback. Prod: must be an explicit CIDR/IP list (dokploy-network subnet + Cloudflare CIDRs); "true" and numeric hop-count are rejected in production.
CORS_ALLOWED_ORIGINS=                        # Optional. Comma-separated web origins allowed to call the API with credentials (cookies). Empty = same-origin/native-only (CORS off). Required for a cross-origin web SPA.

# http server timeouts
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000            # Optional. Default: 65000. Must exceed Traefik backend idle timeout.
HTTP_HEADERS_TIMEOUT_MS=75000               # Optional. Default: 75000. Must be greater than HTTP_KEEP_ALIVE_TIMEOUT_MS.
HTTP_REQUEST_TIMEOUT_MS=80000               # Optional. Default: 80000. Must be >= HTTP_HEADERS_TIMEOUT_MS.
HTTP_SOCKET_TIMEOUT_MS=0                    # Optional. Default: 0 (disabled).

# database
DATABASE_URL=                               # Required. PostgreSQL connection URI (prod: PgBouncer).
MIGRATION_DATABASE_URL=                     # Optional. Direct-PG URI for migrations. Defaults to DATABASE_URL.
DB_POOL_MAX=10                              # Optional. Max pool connections. Default: 10
DB_CONNECT_TIMEOUT_MS=10000                 # Optional. Connection timeout (ms). Default: 10000
DB_IDLE_TIMEOUT_MS=10000                    # Optional. Idle connection timeout (ms), 0 disables. Default: 10000
DB_STATEMENT_TIMEOUT_MS=30000               # Optional. Server-side statement timeout (ms), 0 disables. Default: 30000
DB_SSL=false                                # Optional. Enable TLS for DB connection. Default: false. Required true in production.

# redis
REDIS_URL=                                  # Required. Redis connection URI. Must use rediss:// (TLS) and include a password in production.
REDIS_COMMAND_TIMEOUT_MS=5000               # Optional. Per-command timeout for cache/rate-limit (ms). Default: 5000

# mail
MAIL_DRIVER=log                             # Optional. Enum: [resend, log]. Default: log (real sends need resend; required in production)
MAIL_FROM_NAME=                             # Required. Sender display name (e.g. App)
MAIL_FROM=                                  # Required. Sender email address (e.g. no-reply@yourdomain.com)
RESEND_API_KEY=                             # Required when MAIL_DRIVER is resend
RESEND_WEBHOOK_SECRET=                      # Required when MAIL_DRIVER is resend

# realtime

# security
ENCRYPTION_KEYS=                            # Required. Comma-separated "kid:hexkey" pairs, each key 64-char hex (32 bytes). Example: k1:<hex>,k2:<hex>. Generate a key: openssl rand -hex 32
ENCRYPTION_ACTIVE_KID=                      # Required. Key id used for new encryptions (must exist in ENCRYPTION_KEYS). Rotate by adding a new key and switching this. Example: k1

# auth (access tokens)
JWT_ACCESS_KEYS=                            # Required. Comma-separated "kid:secret" pairs, each secret min 32 chars (HS256). New tokens use the active kid; keep retired keys here until their tokens expire. Example: jwt-k1:<secret>,jwt-k2:<secret>. Generate a secret: openssl rand -base64 48
JWT_ACCESS_ACTIVE_KID=                      # Required. Key id used to sign new access tokens (must exist in JWT_ACCESS_KEYS). Rotate by adding a new key and switching this. See docs/runbooks/jwt-key-rotation.md. Example: jwt-k1
JWT_ACCESS_TTL_SECONDS=900                  # Optional. Access token lifetime (seconds). Default: 900 (15 min)
JWT_ISSUER=app                              # Optional. JWT `iss` claim. Default: app
JWT_AUDIENCE=app                     # Optional. JWT `aud` claim. Default: app
REFRESH_TOKEN_TTL_SECONDS=2592000           # Optional. Refresh token sliding idle lifetime (seconds). Default: 2592000 (30 days)
REFRESH_TOKEN_HARD_CAP_SECONDS=7776000      # Optional. Absolute lifetime ceiling for linked-account refresh chains (seconds). Default: 7776000 (90 days). Guests are not capped.
REFRESH_TOKEN_PEPPER=                       # Required. Server-side pepper for refresh-token hashing, min 32 chars. Generate with CSPRNG: openssl rand -base64 48
CSRF_HMAC_SECRET=                           # Required. Server-side HMAC secret binding the CSRF double-submit token, min 32 chars. Generate with CSPRNG: openssl rand -base64 48
GOOGLE_OAUTH_CLIENT_IDS=                    # Optional (opt-in). Configure only if you use this provider. Comma-separated Google OAuth client IDs accepted as the ID token audience (iOS/Android/web).
APPLE_OAUTH_CLIENT_IDS=                     # Optional (opt-in). Configure only if you use this provider. Comma-separated Apple service/bundle IDs accepted as the ID token audience.
APPLE_OAUTH_ISSUER=https://appleid.apple.com # Optional. Apple ID token issuer. Default: https://appleid.apple.com
GAME_CENTER_BUNDLE_IDS=                     # Optional (opt-in). Configure only if you use this provider. Comma-separated iOS bundle IDs accepted in the Game Center identity signature.
PLAY_GAMES_OAUTH_CLIENT_ID=                 # Optional (opt-in). Configure only if you use this provider. Google Cloud OAuth web client ID used to exchange the Play Games server auth code.
PLAY_GAMES_OAUTH_CLIENT_SECRET=             # Optional (opt-in). Configure only if you use this provider. Secret paired with PLAY_GAMES_OAUTH_CLIENT_ID.
SIGNIN_NONCE_TTL_SECONDS=300                # Optional. Lifetime (seconds) of the single-use sign-in nonce. Default: 300 (5 min)
EMAIL_VERIFICATION_TTL_SECONDS=86400        # Optional. Lifetime (seconds) of the single-use email-verification token. Default: 86400 (24 h)
PASSWORD_RESET_TTL_SECONDS=3600             # Optional. Lifetime (seconds) of the single-use password-reset token. Default: 3600 (1 h)

# api docs & opentelemetry (traces -> Tempo, metrics -> Prometheus, both via Alloy)
DOCS_AUTH_USER=                              # Optional. Basic auth username for the API docs. When set, gates /api/docs and /api/docs-json.
DOCS_AUTH_PASSWORD=                          # Optional. Basic auth password for the API docs (min 24 chars).

SERVICE_RELEASE=unknown                      # Optional. Release id (e.g. git SHA), set by CI. Reported as service.version on traces and metrics.
OTEL_ENABLED=false                          # Enable OpenTelemetry export (traces + metrics). Required true to send either.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318  # Required when OTEL_ENABLED=true. OTLP HTTP endpoint (Alloy).
OTEL_SERVICE_NAME=app                    # Optional. Service name shown in traces. Default: app
OTEL_TRACES_SAMPLER_RATIO=1                 # Optional. Head sampling ratio 0.0-1.0. Default: 1 (dev); lower in prod.
OTEL_DEBUG=false                            # Optional. Print spans to console instead of exporting (debugging).
