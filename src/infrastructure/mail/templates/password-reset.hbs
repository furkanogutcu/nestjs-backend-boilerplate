<!doctype html>
<html lang="en">
  <body style="margin: 0; padding: 24px; font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #1a1a1a;">
    <h2 style="margin: 0 0 16px;">Reset your password</h2>
    <p>We received a request to reset the password for your {{appName}} account.</p>
    <p style="margin: 24px 0;">
      <a
        href="{{actionUrl}}"
        style="display: inline-block; padding: 10px 18px; background: #2563eb; color: #ffffff; text-decoration: none; border-radius: 6px;"
        >Reset password</a
      >
    </p>
    <p>Or paste this link into your browser:</p>
    <p><a href="{{actionUrl}}">{{actionUrl}}</a></p>
    <p style="color: #6b7280; font-size: 14px;">
      This link expires in {{ttlHours}} hours. If you didn't request a reset, you can safely ignore this email — your
      password stays unchanged.
    </p>
  </body>
</html>
