# Consumed by docker-compose.production.yml only — not read by the Node app.
# In Dokploy: paste into the stack's Environment panel.
# Fields marked "Example:" are starting points; tune to your VPS.

# app identity
APP_NAME=                                   # Required. Example: app-prod

# resource limits (docker --memory / --cpus)
DB_MEMORY_LIMIT=                            # Required. Example: 4g (also fed to TS_TUNE_MEMORY)
DB_MEMORY_RESERVATION=                      # Required. Example: 2g
DB_CPU_LIMIT=                               # Required. Example: 2 (also fed to TS_TUNE_NUM_CPUS)
REDIS_MEMORY_LIMIT=                         # Required. Example: 512m
REDIS_MAXMEMORY=                            # Required. Redis maxmemory directive. Example: 384mb (keep below REDIS_MEMORY_LIMIT)
KAFKA_MEMORY_LIMIT=                         # Required. Example: 2g
KAFKA_MEMORY_RESERVATION=                   # Required. Example: 1g
KAFKA_HEAP_OPTS=                            # Required. JVM heap, must stay below KAFKA_MEMORY_LIMIT. Example: -Xms512m -Xmx1g
PGBOUNCER_MEMORY_LIMIT=                     # Required. Example: 128m
PGBOUNCER_MEMORY_RESERVATION=               # Required. Example: 32m

# VPN-only port bindings (10.0.0.1:<port>, reachable only via WireGuard)
VPN_DB_PORT=5442                            # Default: 5442. Host port → Timescale 5432 (debug only)
VPN_PGBOUNCER_PORT=6442                     # Default: 6442. Host port → PgBouncer 6432
VPN_REDIS_PORT=6389                         # Default: 6389. Host port → Redis 6379
VPN_KAFKA_PORT=9192                         # Default: 9192. Host port + Kafka EXTERNAL listener port
VPN_KAFKA_UI_PORT=8090                      # Default: 8090. Host port → kafka-ui 8080
VPN_POSTGRES_EXPORTER_PORT=9187             # Default: 9187. Prometheus scrape target
VPN_PGBOUNCER_EXPORTER_PORT=9127            # Default: 9127. Prometheus scrape target

# Postgres / Timescale
POSTGRES_USER=                              # Required. Example: app_app
POSTGRES_PASSWORD=                          # Required. openssl rand -base64 32
POSTGRES_DB=                                # Required. Example: app

# PgBouncer
PGBOUNCER_AUTH_PASSWORD=                    # Required. openssl rand -base64 32
PGBOUNCER_ADMIN_PASSWORD=                   # Required. openssl rand -base64 32
PGBOUNCER_STATS_PASSWORD=                   # Required. openssl rand -base64 32

# monitoring
POSTGRES_EXPORTER_PASSWORD=                 # Required. openssl rand -base64 32

# Redis
REDIS_PASSWORD=                             # Required. openssl rand -base64 32

# Kafka
KAFKA_CLUSTER_ID=                           # Required. 22-char base64. openssl rand -base64 16 | tr '+/' '_-' | head -c 22
KAFKA_USERNAME=                             # Required. Example: app_kafka
KAFKA_PASSWORD=                             # Required. openssl rand -base64 32
KAFKA_UI_USERNAME=                          # Required. Example: admin
KAFKA_UI_PASSWORD=                          # Required. openssl rand -base64 32

# backup pipeline (pgBackRest → Cloudflare R2)
R2_ENDPOINT=                                # Required. Example: https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=                                  # Required. Example: app-pgbackrest
R2_ACCESS_KEY=                              # Required
R2_SECRET_KEY=                              # Required
BACKUP_ENCRYPTION_PASSPHRASE=               # Required. openssl rand -base64 48
                                            #   ⚠ Store a copy outside the VPS — losing it makes every backup unrecoverable.

# ──────────────────────────────────────────────────────────────────────────────
# observability stack (docker-compose.observability.production.yml)
# Deploy as a separate Dokploy stack on the same dokploy-network as the app.
# ──────────────────────────────────────────────────────────────────────────────

# VPN-only ports (10.0.0.1, reachable only via WireGuard)
VPN_GRAFANA_PORT=3000                       # Default: 3000. Grafana UI (host port → 3000)
VPN_PROMETHEUS_PORT=9090                    # Default: 9090. Prometheus UI (debug)

# Tempo + Loki object storage on Cloudflare R2 (reuses R2_ACCESS_KEY / R2_SECRET_KEY above)
R2_S3_ENDPOINT=                             # Required. HOST ONLY, no scheme. Example: <account-id>.r2.cloudflarestorage.com
TEMPO_R2_BUCKET=                            # Required. Dedicated bucket for traces. Example: app-tempo
LOKI_R2_BUCKET=                             # Required. Dedicated bucket for logs. Example: app-loki

# Retention
TEMPO_RETENTION=720h                        # Default: 720h (30d). Trace block retention.
LOKI_RETENTION=720h                         # Default: 720h (30d). Log retention.
PROMETHEUS_RETENTION=15d                    # Default: 15d. Metric TSDB retention.

# Memory limits
TEMPO_MEMORY_LIMIT=512m                     # Example: 512m
LOKI_MEMORY_LIMIT=512m                      # Example: 512m
PROMETHEUS_MEMORY_LIMIT=1g                  # Example: 1g
ALLOY_MEMORY_LIMIT=256m                     # Example: 256m
GRAFANA_MEMORY_LIMIT=512m                   # Example: 512m

# Grafana
GRAFANA_ADMIN_PASSWORD=                     # Required. openssl rand -base64 24

# NOTE: prometheus.production.yml is NOT env-expanded. Before deploying, replace the
# REPLACE_* tokens in it: app service name, APP_NAME (for exporters) and the app's
# METRICS_AUTH_USER / METRICS_AUTH_PASSWORD (basic auth on /api/v1/metrics).
#
# NOTE: the app's own OpenTelemetry vars are set in the APP's Dokploy env (not here):
#   OTEL_ENABLED=true
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://<APP_NAME>-alloy:4318
#   OTEL_TRACES_SAMPLER_RATIO=1   # start at 1, lower as traffic grows
