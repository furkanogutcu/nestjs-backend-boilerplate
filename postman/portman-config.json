{
  "version": 1.0,
  "$schema": "https://raw.githubusercontent.com/apideck-libraries/portman/main/src/utils/portman-config-schema.json",
  "globals": {
    "stripResponseExamples": false,
    "collectionVariables": {
      "bearerToken": "",
      "refreshToken": "",
      "signinNonce": "",
      "linkNonce": ""
    },
    "keyValueReplacements": {
      "Idempotency-Key": "{{$guid}}"
    }
  },
  "assignVariables": [
    {
      "openApiOperation": "POST::/api/v1/auth/guest",
      "collectionVariables": [
        { "responseBodyProp": "data.access_token", "name": "bearerToken" },
        { "responseBodyProp": "data.refresh_token", "name": "refreshToken" }
      ]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/refresh",
      "collectionVariables": [
        { "responseBodyProp": "data.access_token", "name": "bearerToken" },
        { "responseBodyProp": "data.refresh_token", "name": "refreshToken" }
      ]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/signin/google",
      "collectionVariables": [
        { "responseBodyProp": "data.access_token", "name": "bearerToken" },
        { "responseBodyProp": "data.refresh_token", "name": "refreshToken" }
      ]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/signin/apple",
      "collectionVariables": [
        { "responseBodyProp": "data.access_token", "name": "bearerToken" },
        { "responseBodyProp": "data.refresh_token", "name": "refreshToken" }
      ]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/signin/game-center",
      "collectionVariables": [
        { "responseBodyProp": "data.access_token", "name": "bearerToken" },
        { "responseBodyProp": "data.refresh_token", "name": "refreshToken" }
      ]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/signin/play-games",
      "collectionVariables": [
        { "responseBodyProp": "data.access_token", "name": "bearerToken" },
        { "responseBodyProp": "data.refresh_token", "name": "refreshToken" }
      ]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/signin/nonce",
      "collectionVariables": [{ "responseBodyProp": "data.nonce", "name": "signinNonce" }]
    },
    {
      "openApiOperation": "POST::/api/v1/auth/link/nonce",
      "collectionVariables": [{ "responseBodyProp": "data.nonce", "name": "linkNonce" }]
    }
  ],
  "tests": {
    "contractTests": [
      { "openApiOperation": "*::/*", "statusSuccess": { "enabled": true } },
      { "openApiOperation": "*::/*", "contentType": { "enabled": true } },
      { "openApiOperation": "*::/*", "jsonBody": { "enabled": true } },
      { "openApiOperation": "*::/*", "schemaValidation": { "enabled": true } }
    ]
  }
}
