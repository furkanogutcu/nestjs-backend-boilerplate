{
  "name": "nestjs-backend-boilerplate",
  "version": "0.0.0",
  "description": "Production-grade NestJS backend boilerplate.",
  "author": "furkanogutcu <furkanogutcu.dev@gmail.com>",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/furkanogutcu/nestjs-backend-boilerplate.git"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.6",
      "handlebars": "4.7.9",
      "ioredis": "5.11.1",
      "lodash": "4.18.1",
      "node-forge": "1.4.0",
      "underscore": "1.13.8",
      "flatted": "3.4.2",
      "qs": "6.15.2",
      "js-yaml": "4.2.0",
      "yaml@<1.10.3": "1.10.3",
      "jose@<=4.15.4": "^4.15.5",
      "uuid@<11.1.1": "^11.1.1"
    }
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.md": "prettier --write"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"**/*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "pnpm run typeorm -d dist/database/typeorm.data-source.js migration:run && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "db:create": "ts-node -r tsconfig-paths/register ./src/database/scripts/create-db.script",
    "db:drop": "ts-node -r tsconfig-paths/register ./src/database/scripts/drop-db.script",
    "db:reset": "pnpm db:drop && pnpm db:create && pnpm db:migration:run",
    "db:migration:run": "pnpm run typeorm -d src/database/typeorm.data-source.ts migration:run",
    "db:migration:create": "sh -c 'pnpm run typeorm migration:create ./src/database/migrations/${1#--name=}' sh",
    "db:migration:generate": "sh -c 'pnpm run typeorm -d src/database/typeorm.data-source.ts migration:generate ./src/database/migrations/${1#--name=}' sh",
    "db:migration:revert": "pnpm run typeorm -d src/database/typeorm.data-source.ts migration:revert",
    "docs:generate": "ts-node --transpile-only -r tsconfig-paths/register ./src/infrastructure/docs/scripts/generate-openapi.script.ts",
    "postman:generate": "pnpm docs:generate && portman -l openapi.json -o postman/app-api.postman_collection.json -c postman/portman-config.json -s postman/openapi-to-postman.json",
    "kafka:dlq:replay": "ts-node -r tsconfig-paths/register ./src/infrastructure/kafka/reliability/dlq/scripts/dlq-replay.script.ts",
    "kafka:outbox:requeue": "ts-node -r tsconfig-paths/register ./src/infrastructure/kafka/reliability/outbox/scripts/outbox-requeue.script.ts",
    "obs:up": "docker compose -f docker-compose.observability.yml up -d",
    "obs:down": "docker compose -f docker-compose.observability.yml down"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-express": "^0.68.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-ioredis": "^0.68.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.29.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.66.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/nestjs-api-reference": "^1.2.9",
    "@sentry/nestjs": "^10.65.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bullmq": "^5.80.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-basic-auth": "^1.2.1",
    "google-auth-library": "^10.9.0",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "jose": "^6.2.3",
    "kafkajs": "^2.2.4",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.22.0",
    "pg-connection-string": "^2.14.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^1.0.0",
    "uuidv7": "1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apideck/portman": "^1.35.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testcontainers/kafka": "^12.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.20.1",
    "@types/pluralize": "^0.0.33",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.5",
    "semantic-release": "^25.0.7",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
