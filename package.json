{
  "name": "nestjs-backend-boilerplate",
  "version": "1.0.0",
  "description": "Production-grade NestJS backend boilerplate.",
  "author": "furkanogutcu <furkanogutcu.dev@gmail.com>",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/furkanogutcu/nestjs-backend-boilerplate.git"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@faker-js/faker": "^10.5.0",
      "csv-parse": "^7.0.2",
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "ioredis": "6.0.0",
      "jose@<=4.15.4": "^4.15.5",
      "js-yaml": "^4.3.2",
      "lodash": "4.18.1",
      "multer": "^2.3.0",
      "node-forge": "1.4.0",
      "qs": "^6.16.0",
      "tmp": ">=0.2.6",
      "underscore": "1.13.8",
      "uuid@<11.1.1": "^11.1.1",
      "yaml@<1.10.3": "1.10.3"
    }
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.md": "prettier --write"
  },
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"**/*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "pnpm run typeorm -d dist/database/typeorm.data-source.js migration:run && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "audit": "pnpm audit --audit-level=moderate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "db:create": "ts-node -r tsconfig-paths/register ./src/database/scripts/create-db.script",
    "db:drop": "ts-node -r tsconfig-paths/register ./src/database/scripts/drop-db.script",
    "db:reset": "pnpm db:drop && pnpm db:create && pnpm db:migration:run",
    "db:migration:run": "pnpm run typeorm -d src/database/typeorm.data-source.ts migration:run",
    "db:migration:create": "sh -c 'pnpm run typeorm migration:create ./src/database/migrations/${1#--name=}' sh",
    "db:migration:generate": "sh -c 'pnpm run typeorm -d src/database/typeorm.data-source.ts migration:generate ./src/database/migrations/${1#--name=}' sh",
    "db:migration:revert": "pnpm run typeorm -d src/database/typeorm.data-source.ts migration:revert",
    "docs:generate": "ts-node --transpile-only -r tsconfig-paths/register ./src/infrastructure/docs/scripts/generate-openapi.script.ts",
    "postman:generate": "pnpm docs:generate && portman -l openapi.json -o postman/app-api.postman_collection.json -c postman/portman-config.json -s postman/openapi-to-postman.json",
    "obs:up": "docker compose -f docker-compose.observability.yml up -d",
    "obs:down": "docker compose -f docker-compose.observability.yml down"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@node-rs/argon2": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.68.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/nestjs-api-reference": "^1.2.18",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-basic-auth": "^1.2.1",
    "google-auth-library": "^11.0.2",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.1.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.26.0",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "uuidv7": "1.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@apideck/portman": "^1.35.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.5.0",
    "@types/pluralize": "^0.0.33",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.0",
    "pino-pretty": "^13.1.3",
    "pluralize": "^8.0.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
